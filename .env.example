# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENWEATHERMAP_API_KEY: Optional API key for live OpenWeatherMap API queries.
# Configure via the Secrets panel in AI Studio or enter directly in the in-app weather settings.
OPENWEATHERMAP_API_KEY=

# MAPS_API_KEY: Optional Google Maps Android API Key.
# Configure via the Secrets panel in AI Studio with package name 'com.niharsales.balasore360'
# and SHA-1 certificate fingerprint '3D:C1:86:5F:03:CE:1F:5C:D6:7B:E9:63:29:0B:BD:B2:B7:15:D2:8F'.
# If empty, the app seamlessly runs using the built-in offline vector raster tile provider.
MAPS_API_KEY=
